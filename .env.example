# ---- ZELUX environment template ----
# Copy this file to .env and fill in values. NEVER commit .env.

# Public branding (safe to change at build time)
VITE_APP_NAME="ZELUX"
VITE_APP_TAGLINE="Your reps are your score."

# Science-tech server: one process = WebSocket relay + directory API + static
# app  (npm run server, see server/app.mjs). Set the relay URL to its public
# origin so phones/desktops can battle each other across devices. A bare host
# is fine (ws(s):// is added automatically). If it is unreachable, the client
# falls back to same-browser cross-tab sync via BroadcastChannel.
VITE_REALTIME_RELAY_URL=""

# Directory server (see server/app.mjs). Leave empty for same-origin.
# The optional directory lets players opt in to a public "hall of fame".
VITE_DIRECTORY_URL=""

# AI COACH (optional but recommended).
# The AI coach works fully offline with its built-in coaching engine using
# your real workout data. If you want model-backed coaching, put your API key
# in the app Settings (AI Coach section) OR set VITE_AI_API_KEY here.
# The endpoint uses the OpenAI-compatible /chat/completions shape so you can
# bring your own provider (OpenAI, Groq, Together, OpenRouter, local LLM, etc).
VITE_AI_COACH_ENDPOINT=""
# If left empty the default is https://api.openai.com/v1/chat/completions